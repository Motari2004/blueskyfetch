# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://neondb_owner:npg_0URQHn2lKXeh@ep-divine-rice-ayb8kut7-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================================
# ZERNIO API CONFIGURATION
# ============================================================
# Zernio API Key for Instagram/Facebook/Twitter posting
ZERNIO_API_KEY=sk_7b484f17f3be9f7faa5cabc822983e5760cf4256db3ffa565fb3befdfb6535a6

# Zernio Base URL
ZERNIO_BASE_URL=https://zernio.com/api/v1

# ============================================================
# TIMEZONE CONFIGURATION
# ============================================================
# Default timezone for scheduling
SCHEDULE_TIMEZONE=Africa/Nairobi

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# Port for the Flask server
PORT=10000

# Flask environment (development/production)
FLASK_ENV=development
FLASK_DEBUG=True

# ============================================================
# SECURITY
# ============================================================
# Secret key for Flask sessions (generate your own!)
SECRET_KEY=your-super-secret-flask-key-change-this-in-production

# ============================================================
# VERCEL DEPLOYMENT (optional)
# ============================================================
# Set to 'true' when deploying to Vercel
VERCEL=false

# ============================================================
# BLUESKY CREDENTIALS (for auto-news feature)
# ============================================================
# These can also be set via the UI
AUTO_NEWS_BLUESKY_HANDLE=
AUTO_NEWS_BLUESKY_PASSWORD=

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable/disable auto-news background scheduler
ENABLE_AUTO_NEWS=true

# Enable/disable background scheduler on Vercel
ENABLE_BACKGROUND_SCHEDULER=true

# ============================================================
# LOGGING
# ============================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:10000,https://your-app.vercel.app

# ============================================================
# CACHE CONFIGURATION (optional)
# ============================================================
# Enable Redis caching (if you have Redis)
REDIS_URL=
CACHE_TTL_SECONDS=300

# ============================================================
# RATE LIMITING (optional)
# ============================================================
RATELIMIT_ENABLED=false
RATELIMIT_DEFAULT=100/hour